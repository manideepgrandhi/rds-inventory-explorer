# parameters.baseline.example - your standard parameter values, checked by rds_inventory_explorer.sh --with-parameters.
# Copy it OUTSIDE the release folder (a new release replaces this folder) and point at your copy:
#   cp lib/parameters.baseline.example ~/parameters.baseline
#   ./rds_inventory_explorer.sh ... --with-parameters --baseline ~/parameters.baseline     (or baseline=... in the conf file)
# Without --baseline this bundled example is used; --baseline none turns the checks off.
#
# One rule per line:  engine-family | parameter | rule | value | severity      (# starts a comment; blank lines ignored)
#   engine-family : postgres (RDS + Aurora PostgreSQL), mysql (RDS MySQL / MariaDB + Aurora MySQL), sqlserver, oracle,
#                   or aurora-postgresql / aurora-mysql for Aurora only
#   rule          : =  !=  in  contains  !contains  >  >=  <  <=  between  set
#                   in / contains / !contains take a comma list; between takes MIN-MAX; set takes no value (any non-empty value)
#   severity      : high | medium | low
# Values: 1/on/true/yes and 0/off/false/no are the same; numbers are compared as numbers; {DBInstanceClassMemory...}
# formulas are estimated from the instance class (marked approx). A parameter the engine version does not have is "n/a".
# log_connections: PostgreSQL 18+ takes a list (receipt,authentication,authorization,setup_durations / all); "= 1" passes
# when it is on / all or lists receipt, authentication and authorization.
# Every parameter named here is collected by --with-parameters even when lib/parameters.list does not list it.

## PostgreSQL (Aurora + RDS)
postgres | rds.force_ssl                        | =        | 1                                    | high
postgres | ssl_min_protocol_version             | in       | TLSv1.2,TLSv1.3                      | high
postgres | password_encryption                  | =        | scram-sha-256                        | high
postgres | shared_preload_libraries             | contains | pg_stat_statements,pgaudit,pg_tle    | high
postgres | pgaudit.log                          | set      |                                      | medium
postgres | log_connections                      | =        | 1                                    | medium
postgres | log_disconnections                   | =        | 1                                    | medium
postgres | log_lock_waits                       | =        | 1                                    | medium
postgres | log_min_duration_statement           | between  | 1000-5000                            | medium
postgres | log_autovacuum_min_duration          | between  | 0-10000                              | low
postgres | log_statement                        | in       | ddl,mod                              | low
postgres | idle_in_transaction_session_timeout  | between  | 60000-3600000                        | medium
postgres | statement_timeout                    | >=       | 0                                    | low
postgres | autovacuum                           | =        | 1                                    | high
postgres | autovacuum_max_workers               | >=       | 3                                    | low
postgres | autovacuum_vacuum_scale_factor       | <=       | 0.1                                  | low
postgres | track_io_timing                      | =        | 1                                    | low
postgres | track_activity_query_size            | >=       | 4096                                 | low
postgres | random_page_cost                     | <=       | 1.5                                  | low
postgres | max_replication_slots                | >=       | 10                                   | low

## SQL Server
sqlserver | rds.force_ssl                       | =        | 1                                    | high
sqlserver | rds.tls10                           | =        | disabled                             | high
sqlserver | rds.tls11                           | =        | disabled                             | high
sqlserver | contained database authentication   | =        | 0                                    | medium
sqlserver | clr enabled                         | =        | 0                                    | medium
sqlserver | remote access                       | =        | 0                                    | low
sqlserver | optimize for ad hoc workloads       | =        | 1                                    | low
sqlserver | cost threshold for parallelism      | >=       | 50                                   | low
sqlserver | max degree of parallelism           | between  | 1-8                                  | low

## Oracle
oracle | audit_trail                          | in       | DB,DB_EXTENDED,OS,XML                | high
oracle | sec_case_sensitive_logon             | =        | TRUE                                 | medium
oracle | open_cursors                         | >=       | 300                                  | low

## MySQL / Aurora MySQL
mysql | require_secure_transport              | =        | ON                                   | high
mysql | tls_version                           | contains | TLSv1.2                              | high
mysql | tls_version                           | !contains| TLSv1,TLSv1.1                        | high
mysql | slow_query_log                        | =        | 1                                    | medium
mysql | long_query_time                       | between  | 1-5                                  | low
mysql | general_log                           | =        | 0                                    | low
mysql | binlog_format                         | =        | ROW                                  | medium
mysql | server_audit_logging                  | =        | 1                                    | medium
