# rds_inventory_explorer.sh --config FILE
# key=value, long option names without "--". Never sourced. Command-line options override these.
# profile=prod,dev
# region=us-east-1,ap-south-1
all-regions=true
# no-discover=false
# probe-parallel=8
# include-docdb=false
format=html,csv
# with-parameters=true
# baseline=~/parameters.baseline        (copy lib/parameters.baseline.example outside the release folder; none = off)
# skip-checks=default_port,gp2_storage
# save-data=true
# output-dir=./reports
# prefix=rds_inventory_explorer
# tz=Asia/Kolkata
# aws-timeout=30
# max-attempts=5
